APP_NAME="Sistema de Gestión TI"
APP_VERSION=1.0.0
SECRET_KEY=
# Supabase > Connect > Transaction pooler (6543), con sslmode=require.
# Codificar los caracteres especiales de la contraseña en la URL.
DATABASE_URL=
ASSEMBLYAI_API_KEY=
SESSION_COOKIE_SECURE=True
ENABLE_REGISTRATION=False
FLASK_DEBUG=False
# Solo para desarrollo local sin DATABASE_URL:
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=ti_management

# Clasificador por voz mediante AssemblyAI LLM Gateway
ASSEMBLYAI_CLASSIFIER_MODEL=qwen3.5-4b-32k-fast
